#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1
start_service() {
 [ -s /etc/droidwrt/active-mihomo.json ] || return 0
 sysctl -w net.ipv6.conf.default.disable_ipv6=0 >/dev/null || return 1
 procd_open_instance
 procd_set_param command /usr/bin/mihomo -d /etc/droidwrt/mihomo -f /etc/droidwrt/active-mihomo.json
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
